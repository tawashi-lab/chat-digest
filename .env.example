# chat-digest 環境変数サンプル。コピーして .env を作成してください。
# Copy to .env and fill in your secrets. Never commit the real .env.

# --- LLM API keys(使うプロバイダのみ設定) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Grok(topic_context / fact_check 機能を使う場合のみ)
GROK_API_KEY=

# --- Discord ---
# config.yaml の sources.*.token_env で参照する名前に合わせる
DISCORD_TOKEN_MYSERVER=
# config.yaml の outputs.*.url_env で参照する名前に合わせる
WEBHOOK_MYSERVER_SUMMARY=

# --- Telegram(telegram source を使う場合のみ) ---
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
